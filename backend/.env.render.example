APP_NAME=Cabuyao CHO-I System
APP_ENV=production
APP_KEY=base64:your-generated-app-key
APP_DEBUG=false
APP_URL=https://cabuyao-cho1-system.onrender.com
AUTH_EXPOSE_CODES=true

FRONTEND_URL=https://cabuyao-cho-1-system.vercel.app
SANCTUM_STATEFUL_DOMAINS=cabuyao-cho-1-system.vercel.app

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=your-database-host
DB_PORT=3306
DB_DATABASE=your-database-name
DB_USERNAME=your-database-username
DB_PASSWORD=your-database-password

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@cabuyao-cho1.local
MAIL_FROM_NAME=Cabuyao CHO-I System
